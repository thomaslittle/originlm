{
  "license": "Apache-2.0",
  "name": "@originlm/site",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "OriginLM landing page: one local runtime for AI usage and for apps built on the user's own AI.",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5177 --strictPort",
    "build": "tsc -p tsconfig.json --noEmit && vite build && vite build --ssr src/entry-server.tsx --outDir .prerender && node scripts/prerender.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 5177 --strictPort",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check:samples": "node scripts/check_samples.mjs",
    "check:contrast": "node scripts/check_contrast.mjs",
    "capture:stills": "node scripts/capture_stills.mjs",
    "capture:frames": "node scripts/capture_frames.mjs",
    "capture:concepts": "node scripts/capture_concepts.mjs"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "5.3.0",
    "gsap": "3.15.1",
    "lenis": "1.3.27",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "playwright-core": "^1.63.0",
    "typescript": "5.9.3",
    "vite": "8.3.3"
  }
}
